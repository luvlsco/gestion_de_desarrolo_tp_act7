# Plantilla de variables de entorno.
# Copiar este archivo como .env y completar las claves.
# En local/docker-compose solo se usan las 4 de MySQL.
# En la nube (Render) se usan DATABASE_URL + SENTRY_DSN.
MYSQL_ROOT_PASSWORD=cambiar_esta_clave
MYSQL_DATABASE=tienda
MYSQL_USER=appuser
MYSQL_PASSWORD=cambiar_esta_clave

# --- Solo nube (Actividad 7, configurar en Render, NO en .env local) ---
# URI completa que da Aiven (Free MySQL): mysql+pymysql://user:pass@host:port/db
# DATABASE_URL=
# DSN que da Sentry (Project > Settings > Client Keys):
# SENTRY_DSN=
# ENVIRONMENT=production
